# =====================================================
# 主入口
# =====================================================
CMD="${1:-menu}"
shift || true

case "$CMD" in
    start)      cmd_start "$@" ;;
    stop)       cmd_stop "$@" ;;
    restart)    cmd_restart "$@" ;;
    status|st)  cmd_status ;;
    list|ls)    cmd_list ;;
    add)        cmd_add ;;
    remove|rm)  cmd_remove "$@" ;;
    log)        cmd_log "$@" ;;
    install)    cmd_install ;;
    uninstall)  cmd_uninstall ;;
    connect|cn) cmd_connect ;;
    novnc)      cmd_novnc "$@" ;;
    scan)
        # 快捷：jf scan wifi → 掃描 WiFi 子網
        if [[ "${1:-}" == "wifi" ]]; then
            cmd_scan "192.168.168" 1 254
        else
            cmd_scan "$@"
        fi ;;
    open)       cmd_open "$@" ;;
    menu)       cmd_menu ;;
    help|-h|--help) cmd_help ;;
    *)          err "未知指令：$CMD"; cmd_help; exit 1 ;;
esac
