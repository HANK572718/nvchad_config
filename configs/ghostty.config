# Ghostty 設定（macOS）— 搭配 tmux + NvChad (Neovim)
#
# 原始檔存放於 nvchad_config repo：configs/ghostty.config
# Ghostty 實際讀取路徑為 ~/.config/ghostty/config，已用 symlink 指向本檔，
# 故編輯本檔即等於編輯生效設定（重開 Ghostty 或 cmd+shift+, 重載）。
#
# 驗證：/Applications/Ghostty.app/Contents/MacOS/ghostty +validate-config

# ── 字型 ──────────────────────────────────────────────
# NvChad 圖示需 Nerd Font；已安裝 JetBrainsMono Nerd Font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# ── 外觀 / 主題 ───────────────────────────────────────
# 其他可選：Gruvbox Dark、Nord、Onenord、Catppuccin Macchiato（+list-themes 可列全部）
theme = Catppuccin Mocha
window-padding-x = 8
window-padding-y = 6
mouse-hide-while-typing = true

# ── macOS / tmux 鍵盤 ─────────────────────────────────
# Option 當作 Alt/Meta：tmux.conf 的 Alt+Shift+數字 切 window、
# 以及 Neovim 的 <M-BS> 刪詞才會生效
macos-option-as-alt = true

# ── 剪貼簿（支援 Neovim OSC52 複製）───────────────────
clipboard-write = allow
# clipboard-read 維持預設 ask（安全考量：SSH 端要求貼上時會先詢問）

# ═══ 切換鍵：全部做成 Ghostty keybind ═══════════════
# 為什麼做成 keybind：macOS 上 keybind 在「輸入法(IME)之前」處理，
# 所以用注音等中文輸入法時也能切換（Option 的組合會先被 IME 吃掉，
# 做成 keybind 後才不被攔截）。Cmd 系列天生走 App、不進 IME。
#
# ── nvim buffer：(Option|Cmd)+數字 → ESC+數字（= Alt+數字）──
# 穿過 tmux（tmux 未綁 M-1..9）直達 Neovim，由 mappings.lua 的 <A-1..9> 切 buffer
# Option 同時綁邏輯鍵與實體鍵 physical:：試圖讓 Ghostty 在注音 IME 之前搶到按鍵
# （注音下數字鍵=注音符號，實體鍵綁定有機會搶先；若仍組成注音則屬先天限制）。
keybind = alt+one=esc:1
keybind = alt+physical:one=esc:1
keybind = alt+two=esc:2
keybind = alt+physical:two=esc:2
keybind = alt+three=esc:3
keybind = alt+physical:three=esc:3
keybind = alt+four=esc:4
keybind = alt+physical:four=esc:4
keybind = alt+five=esc:5
keybind = alt+physical:five=esc:5
keybind = alt+six=esc:6
keybind = alt+physical:six=esc:6
keybind = alt+seven=esc:7
keybind = alt+physical:seven=esc:7
keybind = alt+eight=esc:8
keybind = alt+physical:eight=esc:8
keybind = alt+nine=esc:9
keybind = alt+physical:nine=esc:9
# cmd 這組同時綁「邏輯鍵」與「實體鍵 physical:」兩種形式。原因：Ghostty 預設把
# 「切分頁 goto_tab」綁在【實體鍵】super+digit_N 上，只覆蓋邏輯 super+N 蓋不掉它
# （按 Cmd+數字仍會被分頁層吃掉）。兩種都改成 esc:N 才能徹底變成「切 buffer」。
keybind = cmd+one=esc:1
keybind = cmd+physical:one=esc:1
keybind = cmd+two=esc:2
keybind = cmd+physical:two=esc:2
keybind = cmd+three=esc:3
keybind = cmd+physical:three=esc:3
keybind = cmd+four=esc:4
keybind = cmd+physical:four=esc:4
keybind = cmd+five=esc:5
keybind = cmd+physical:five=esc:5
keybind = cmd+six=esc:6
keybind = cmd+physical:six=esc:6
keybind = cmd+seven=esc:7
keybind = cmd+physical:seven=esc:7
keybind = cmd+eight=esc:8
keybind = cmd+physical:eight=esc:8
keybind = cmd+nine=esc:9
keybind = cmd+physical:nine=esc:9
# 註：cmd+0 保留為 Ghostty 預設「重設字型大小」（buffer 只有 1-9）
#
# ── tmux window：Option+Shift+數字 → ESC+shifted 符號（M-! ..M-(）──
# 由 tmux root table 直接接（切窗不受 nvim 影響）。做成 keybind 以繞過注音 IME。
# 只用 Option+Shift、不用 Cmd+Shift：cmd+shift+3/4/5 是 macOS 系統截圖快捷鍵，
# 會被系統攔截；Option+Shift+數字 不與任何 macOS 系統快捷鍵衝突。
# esc:<符號> = 在該符號前面加一個 ESC（等同 M-<符號>），與上面 esc:數字 一致。
#   1=! 2=@ 3=# 4=$ 5=% 6=^ 7=& 8=* 9=(
keybind = alt+shift+one=esc:!
keybind = alt+shift+two=esc:@
keybind = alt+shift+three=esc:#
keybind = alt+shift+four=esc:$
keybind = alt+shift+five=esc:%
keybind = alt+shift+six=esc:^
keybind = alt+shift+seven=esc:&
keybind = alt+shift+eight=esc:*
keybind = alt+shift+nine=esc:(

# ── Claude Code 內部捲動：Cmd+K/J → PageUp/PageDown ──────────
# 為什麼不用 Ctrl+U/D：那組已被 mappings.lua 的 t-mode 映射攔下做 nvim 捲動
# （<C-\><C-n> 退出 terminal mode 再捲），永遠送不到 terminal 裡的程式。
# 改由 Cmd 在 Ghostty 這層轉成 PageUp/PageDown，逐段穿透：
#   tmux 放行（PPage/NPage 只綁在 copy-mode 與 prefix table，root table 未綁）
#   → nvim 無 PageUp/PageDown 映射，原樣透傳（實測送出 1b 5b 35 7e / 1b 5b 36 7e）
#   → Claude Code 的 Scroll context 預設已綁 pageup/pagedown，故 CC 端無需任何設定。
# k=上 j=下，對齊 vim 慣例；CC 的 scroll:pageUp 實作是捲 viewportHeight/2，
# 即半頁，手感等同 Ctrl+U/D。
#
# 用途：agent view 等 fullscreen（alt-screen）畫面。alt-screen 不會累積 scrollback，
#       nvim 那套 Ctrl+U/D 在該情境捲不到東西，只能靠 CC 自己的內部捲動。
#       分工：Ctrl+U/D → nvim 捲動（主 session）；Cmd+K/J → CC 內部捲動（agent view）。
# 代價：覆蓋 Ghostty 預設 cmd+k=clear_screen、cmd+j=scroll_to_selection。
keybind = cmd+k=csi:5~
keybind = cmd+j=csi:6~
